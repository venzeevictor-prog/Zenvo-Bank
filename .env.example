# --- Core ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database (Aiven PostgreSQL in production; TLS required) ---
DATABASE_URL=postgres://user:password@localhost:5432/zenvobank
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----...
DATABASE_POOL_MAX=10

# --- Sessions ---
SESSION_TTL_HOURS=12
STAFF_SESSION_TTL_HOURS=8

# --- First administrator (used only by `npm run create-admin`) ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Providers (placeholders only; none are connected in this build) ---
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
FX_PROVIDER_API_KEY=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
KYC_PROVIDER_API_KEY=
